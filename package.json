{
  "name": "dokkan-web-scraper",
  "version": "1.0.1",
  "description": "Character data from DokkanStats and event/stage metadata from Dokkan Info, with DokkanDB boss skills.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib', {recursive:true, force:true})\" && tsc",
    "watch": "npm run build && tsc -w",
    "test": "mocha",
    "run": "ts-node dokkanstats.ts",
    "run:dokkanstats": "npx ts-node dokkanstats.ts",
    "run:dokkaninfo": "npx ts-node dokkaninfo.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MNprojects/DokkanWebScraper.git"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "jsdom": "^20.0.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "type": "commonjs"
}
